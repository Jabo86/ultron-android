{
  "expo": {
    "name": "UNVOR Chat",
    "slug": "ultron-messenger",
    "scheme": [
      "unvor",
      "ultron"
    ],
    "version": "3.5.20",
    "orientation": "portrait",
    "icon": "./assets/unvor/logo.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ultron.messenger",
      "infoPlist": {
        "NSFaceIDUsageDescription": "UNVOR usa il riconoscimento biometrico per sbloccare le tue conversazioni cifrate.",
        "NSPhotoLibraryUsageDescription": "UNVOR accede alle foto per allegarle in chat (cifrate end-to-end).",
        "NSPhotoLibraryAddUsageDescription": "UNVOR salva nella tua galleria le foto ricevute in chat."
      }
    },
    "android": {
      "package": "com.ultron.messenger",
      "versionCode": 187,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/unvor/logo.jpg",
        "monochromeImage": "./assets/unvor/notification.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/unvor/logo.jpg",
      "bundler": "metro"
    },
    "plugins": []
  }
}
