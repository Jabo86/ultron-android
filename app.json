{
  "expo": {
    "name": "ULTRON",
    "slug": "ultron-messenger",
    "scheme": "ultron",
    "version": "3.5.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ultron.messenger",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ULTRON usa il riconoscimento biometrico per sbloccare le tue conversazioni cifrate.",
        "NSPhotoLibraryUsageDescription": "ULTRON accede alle foto per allegarle in chat (cifrate end-to-end).",
        "NSPhotoLibraryAddUsageDescription": "ULTRON salva nella tua galleria le foto ricevute in chat."
      }
    },
    "android": {
      "package": "com.ultron.messenger",
      "versionCode": 183,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": []
  }
}
